    });

    const target = event.currentTarget;
    target.classList.add('ring-2', 'ring-primary', 'shadow-md');
    target.classList.remove('shadow-sm');

    // Auto open drawer if closed
    if (!isDrawerOpen) {
      toggleDrawer();
    }
  }

